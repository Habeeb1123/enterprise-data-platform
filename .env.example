DB_HOST=localhost
DB_PORT=5433
DB_NAME=datacareer_db
DB_USER=datacareer_user
DB_PASSWORD=change_me

# URL-encoded version of DB_PASSWORD for SQLAlchemy/Airflow connection strings.
# Example: "@" becomes "%40"
DB_PASSWORD_URLENC=change_me

# Local-development secret used by Airflow API authentication.
AIRFLOW_JWT_SECRET=change_me_to_a_long_random_secret